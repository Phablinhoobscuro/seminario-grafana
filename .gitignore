# =========================================================
# Seminário Grafana
# Arquivos e diretórios que não devem ser versionados
# =========================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente / segredos
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Cobertura e artefatos de build
coverage/
dist/
build/

# Arquivos temporários
tmp/
temp/
*.tmp
*.bak
*.swp

# IDEs e editores
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Dados locais gerados pelos serviços
grafana/data/
prometheus/data/

# Docker
*.pid

# Pacotes compactados locais
*.zip
